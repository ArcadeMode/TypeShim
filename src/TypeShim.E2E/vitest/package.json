{
  "name": "@typeshim/e2e-vitest",
  "private": true,
  "type": "module",
  "scripts": {
    "test:node": "cross-env VITE_BROWSER_MODE=false vitest run",
    "test:browser": "cross-env VITE_BROWSER_MODE=true vitest run",
    "bench:node": "cross-env NODE_OPTIONS=--expose-gc && vitest bench --run",
    "initialize": "dotnet build ../TypeShim.E2E.Wasm && npm ci && npx playwright install chromium --with-deps",
    "build": "dotnet build ../TypeShim.E2E.Wasm"
  },
  "devDependencies": {
    "@emnapi/runtime": "^1.11.3",
    "@types/node": "^26.6.5",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "unplugin-dotnet-wasm": "^1.5.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  }
}
